# ==========================================================================
# LLM-Assisted Observability & Security Platform - configuration
# Copy to .env and adjust. Everything has a safe default for the SIMULATED demo.
# ==========================================================================

# Execution mode: simulated | live
#   simulated  -> deterministic stateful simulated cluster (no infra needed)
#   live       -> query real Prometheus/OpenSearch/Kubernetes, falls back to
#                 simulation per-component when unavailable
#   auto       -> let each component decide based on availability
EXTERNAL_MODE=simulated

# --- LLM provider -----------------------------------------------------------
# mock | openai | ollama
# mock is deterministic, offline and evidence-driven (recommended for the demo).
LLM_PROVIDER=mock

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# --- Tracing (Langfuse) ----------------------------------------------------
LANGFUSE_ENABLED=true          # self-hosted on http://localhost:3000 (docker/langfuse-compose.yml)
LANGFUSE_PUBLIC_KEY=pk-lf-976d879582b60acf
LANGFUSE_SECRET_KEY=sk-lf-31905c84394ffc10
LANGFUSE_HOST=http://localhost:3000

# --- Observability backends (live mode) ------------------------------------
PROMETHEUS_URL=http://localhost:9090
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
GRAFANA_URL=http://localhost:3001       # admin / admin
SLACK_ENABLED=true                      # POSTs to local sink (docker/slack-sink)
SLACK_WEBHOOK_URL=http://localhost:5050/hooks/demo
SLACK_CHANNEL=#ai-observability

# --- Simulation -------------------------------------------------------------
# When true, live adapters in latest mode will be bypassed and everyone uses
# the in-process model. Keeps the whole demo on one machine.
FORCE_SIMULATION=true

# --- Platform ---------------------------------------------------------------
DATA_DIR=data
KNOWLEDGE_DIR=knowledge
NAMESPACE=ai-observability-demo
CLUSTER_NAME=demo-cluster
CERT_THRESHOLD_DAYS=30

# --- Policy tuning ----------------------------------------------------------
# Only sustained high CPU + auto-scale is allowed to run without approval.
MAX_AUTOSCALE_ORIGIN_REPLICAS=4
MAX_AUTOSCALE_DELTA=2
MAX_AUTOSCALE_REPLICAS=8

# JSON arrays — pydantic-settings decodes list fields from .env as JSON.
# Deployment + serviceaccount allowlists (policy safety for scenario 3 + 7)
ALLOWED_DEPLOYMENTS=["demo-app","cpu-demo","memory-demo","crash-demo","cert-demo","test-pod"]
ALLOWED_NAMESPACES=["ai-observability-demo"]
# Optional: only roll back RBAC whose subject is allowlisted here (default: none restricted)
#ALLOWED_RBAC_SUBJECTS=["ci-bot"]

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- RAG knowledge store (managed locally) -----------------------------------
# auto        -> use whatever DB is reachable (pgvector → opensearch → tfidf)
# pgvector    -> vector + tsvector hybrid, requires the local pgvector service
# opensearch  -> BM25 over the knowledge-chunks index, requires local OpenSearch
# tfidf       -> pure-python index over knowledge/**/*.md (always available)
RAG_STORE=auto
PGVECTOR_URL=postgresql://rag:rag@localhost:5434/rag
OPENSEARCH_INDEX_KNOWLEDGE=knowledge-chunks